---
import Icon from "./Icon.astro";
import {createPublicationSearchText} from "../lib/publication-search.mjs";
const {paper, featured = false} = Astro.props;
const own = paper.authors.findIndex((a: {self: boolean}) => a.self);
const indices = [...new Set([0, 1, 2, own, paper.authors.length - 1])].filter(i => i >= 0 && i < paper.authors.length).sort((a,b) => a-b);
const compact = paper.authors.length <= 5 ? paper.authors.map((_: unknown,i: number) => i) : indices;
---
<article class:list={["publication", {featured}]} data-publication data-year={paper.year} data-status={paper.status} data-search={createPublicationSearchText(paper)}>
  <div class="publication-meta"><span class:list={["venue-label",{"venue-accepted":paper.status === "Accepted"}]}>{paper.venue} {paper.year}</span><span>{paper.status}</span></div>
  <h3><a href={paper.website || paper.pdf || ("https://doi.org/" + paper.doi)}>{paper.title}</a></h3>
  {featured && paper.highlight && <p class="publication-highlight">{paper.highlight}</p>}
  <div class="author-line">
    <span>{compact.map((index: number,position: number)=><Fragment>{position > 0 && (index > compact[position-1]+1 ? ", …, " : ", ")}{paper.authors[index].self ? <strong>{paper.authors[index].first} {paper.authors[index].last}</strong> : <span>{paper.authors[index].first} {paper.authors[index].last}</span>}</Fragment>)}</span>
    {paper.authors.length > 5 && <details class="all-authors"><summary>All {paper.authors.length} authors</summary><p>{paper.authors.map((a: {first:string;last:string;self:boolean}, i:number)=><Fragment>{i>0 && ", "}{a.self ? <strong>{a.first} {a.last}</strong> : <span>{a.first} {a.last}</span>}</Fragment>)}</p></details>}
  </div>
  <div class="publication-links">
    {paper.pdf && <a href={paper.pdf}>Paper <Icon size={13}/></a>}
    {paper.website && <a href={paper.website}>Website <Icon size={13}/></a>}
    {paper.code && <a href={paper.code}>Code <Icon size={13}/></a>}
    {paper.doi && <a href={"https://doi.org/" + paper.doi}>DOI <Icon size={13}/></a>}
    <details class="citation"><summary>BibTeX</summary><div class="citation-panel"><pre>{paper.bibtex}</pre><button class="copy-citation" type="button">Copy citation</button></div></details>
  </div>
</article>
<script>
  document.querySelectorAll<HTMLButtonElement>(".copy-citation").forEach(button => {
    button.addEventListener("click", async () => {
      const text = button.closest(".citation-panel")?.querySelector("pre")?.textContent;
      if(!text) return;
      try { await navigator.clipboard.writeText(text); button.textContent = "Copied"; }
      catch { button.textContent = "Select and copy the citation above"; }
    });
  });
</script>
