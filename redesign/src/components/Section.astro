---
interface Props { number?: string; title: string; subtitle?: string; id?: string; link?: string; linkLabel?: string; }
const {number, title, subtitle, id, link, linkLabel = "View all"} = Astro.props;
---
<section class="section" id={id}><div class="content-container">
  <div class="section-heading"><div><p class="eyebrow">{number && <span>{number} / </span>}{subtitle}</p><h2>{title}</h2></div>{link && <a class="text-link" href={link}>{linkLabel}<span aria-hidden="true">↗</span></a>}</div>
  <slot/>
</div></section>
