---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProjectCard from "../../components/ProjectCard.astro";
import data from "../../../.cache/site.json";
---
<BaseLayout title="Projects"><div class="content-container page-content"><header class="page-heading"><p class="eyebrow">RESEARCH / PROJECTS</p><h1>Making ideas<br/><em>tangible.</em></h1><p>Models, benchmarks, and tools for understanding the scientific world.</p></header><div class="project-grid">{data.projects.map((project,index)=><ProjectCard project={project} index={index}/>)}</div><div class="page-note"><a class="text-link" href="/repositories/">Explore research repositories <span aria-hidden="true">↗</span></a></div></div></BaseLayout>
