---
import BaseLayout from "../layouts/BaseLayout.astro";
import Icon from "../components/Icon.astro";
import {author} from "../config";
import data from "../../.cache/site.json";
---
<BaseLayout title="Curriculum Vitae"><div class="content-container page-content"><header class="page-heading"><p class="eyebrow">BACKGROUND / EXPERIENCE</p><h1>A path shaped<br/><em>by curiosity.</em></h1><p>Researcher at Shanghai AI Laboratory. Previously trained in Luxembourg, Karlsruhe, and Shanghai.</p><a class="button button-primary" href={author.cv} download>Download PDF CV <Icon name="download"/></a></header><div class="cv-sections">{data.cv.filter(section=>section.type!=="publications").map(section=><section class="cv-section"><h2>{section.title}</h2><div>{section.contents?.map((item:any)=><div class="cv-item">{section.type==="map" ? <><span class="cv-label">{item.name}</span><p>{item.value}</p></> : typeof item==="string" ? <p>{item}</p> : <><span class="cv-label">{item.year}</span><div>{item.title && <h3>{item.title}</h3>}{item.institution && <p>{item.institution}</p>}{item.description && <ul>{item.description.map((line:string)=><li>{line}</li>)}</ul>}{item.items && <ul>{item.items.map((line:string)=><li>{line}</li>)}</ul>}</div></>}</div>)}</div></section>)}</div><a class="text-link" href="/publications/">See all {data.papers.length} publications <span aria-hidden="true">↗</span></a></div></BaseLayout>
