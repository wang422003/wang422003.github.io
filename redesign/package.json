{
  "name": "aoran-wang-academic-preview",
  "version": "1.0.0",
  "description": "Editorial academic website preview for Aoran Wang",
  "type": "module",
  "scripts": {
    "sync:content": "node scripts/sync-content.mjs",
    "dev": "npm run sync:content && astro dev --host 127.0.0.1",
    "build": "npm run sync:content && astro build",
    "check": "astro check",
    "preview": "astro preview --host 127.0.0.1",
    "pretest": "npm run sync:content",
    "test": "node --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "validate": "npm run build && npm run check && npm test && npm run verify:build"
  },
  "dependencies": {
    "katex": "^0.17.0",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.0",
    "@astrojs/rss": "^4.0.0",
    "astro": "^5.0.0",
    "typescript": "^5.7.0"
  }
}
